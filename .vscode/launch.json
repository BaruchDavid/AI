{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: app.py",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/Langchain/6-Ollama_GenIA/app.py"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Code Agent: main.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Langchain/12-Langgraph-Code-Factory/main.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Streamlit: 15-ChatBot",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/Langchain/15-ChatBot/app.py"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}/Langchain/15-ChatBot"
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
